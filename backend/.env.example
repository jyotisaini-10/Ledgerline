# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/ledgerline

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Redis (optional - comment out to disable)
# REDIS_URL=redis://localhost:6379

# Plaid (optional - for real bank connections)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox
PLAID_REDIRECT_URI=http://localhost:3000/api/plaid/callback

# ML Model Settings
SUBSCRIPTION_CONFIDENCE_THRESHOLD=0.7
ANOMALY_CONFIDENCE_THRESHOLD=0.8
